{
  // ------------------------------------------------------------------
  // DATABASE: "Sqlite" = local dev (file attendance.db, no server needed).
  // To run on SQL Server in production, change this ONE value to
  // "SqlServer" and set the SqlServer connection string below to the
  // real server. No code changes needed — Program.cs picks the provider
  // from this setting. See ../DATABASE.md for the full notes.
  // ------------------------------------------------------------------
  "DatabaseProvider": "Sqlite",

  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=AttendanceLeaveDB;Trusted_Connection=True;TrustServerCertificate=True",
    "Sqlite": "Data Source=attendance.db"
  },

  // JWT signing. The dev key below is ONLY for local testing — in
  // production set a long random secret via the Jwt__Key env variable.
  "Jwt": {
    "Key": "attendance-leave-dev-secret-key-please-change-me-1234567890",
    "Issuer": "AttendanceLeaveApp",
    "Audience": "AttendanceLeaveApp",
    "ExpiresHours": 8
  },

  // Frontend origins allowed to call this API (CORS).
  "AllowedOrigins": [
    "http://localhost:4200"
  ],

  // Email (leave approve/reject notifications). Leave SmtpHost EMPTY to
  // disable email — the API logs a warning and carries on, it never
  // crashes and never pretends an email was sent. Put real credentials
  // in appsettings.Development.json (not committed) or env variables.
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPass": "",
    "FromEmail": "hr@company.com",
    "EnableSsl": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
